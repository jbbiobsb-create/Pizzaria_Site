{
  "observacao": "Estruturas de dados observadas nas respostas da API pública do site da Domino's Brasil (prd-dominos.alphacode.com.br/apiV1). Use apenas como referência de MODELAGEM. Nomes de produtos e preços são deles e não devem ser copiados.",
  "endpoints_observados": [
    "GET getBannerV2/?storeId&deliveryType&type=HOME|COUPON  -> banners da home / promoções",
    "GET getBestCoupons/?storeId&deliveryType -> 3 ofertas em destaque na home",
    "GET getMenu/?storeId -> categorias > seções (Mais pedidas, Clássicas, Especiais) > produtos (preço 'a partir de', price_max, minSize)",
    "GET getThematicMenu/?storeId&deliveryType -> categorias temáticas/sazonais com data de início/fim e horário ativo",
    "GET zipCodeV2/{cep}/ -> autocompleta rua/bairro/cidade/UF",
    "POST address -> salva endereço (nome, rua, número, complemento, bairro, cidade, UF, CEP, lat, long)",
    "GET getStore/?zipCode&city&state&neighborhood&street&number&lat&long -> lojas para delivery e takeout: taxa de entrega, distância, horário, isOpen, slots de agendamento por data",
    "GET getPaymentMethods/?storeId -> métodos (OFFLINE, CREDIT_CARD, PIX) e bandeiras",
    "GET getPizzas/?storeId -> tamanhos, massas (com sub-bordas e preço por tamanho) e matriz de variantes código=TAMANHO+MASSA+SABOR",
    "GET getProductDetails/?flavorCode&storeId -> ingredientes padrão, toppings extras, massas, tamanhos, restrições por tamanho",
    "GET getProductToppings/?productCode&storeId -> ingredientes da metade (meio a meio)",
    "GET upsell/?store_id&category_id&size_code -> sugestões após adicionar (bebidas, sobremesas, acompanhamentos)",
    "GET getUpgrade/?storeId&productCode -> oferta de upgrade de tamanho no carrinho",
    "POST cartPrice -> subtotal, desconto, taxa de entrega, total, tempo de preparo (min/max)",
    "GET getCoupons/?storeId&deliveryType -> lista de promoções",
    "GET getCouponDetails/{id}/ -> grupos de produtos da promoção (categoria, tamanhos permitidos, massas permitidas, quantidade obrigatória, preço, desconto máximo)"
  ],
